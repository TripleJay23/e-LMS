{{!
    @template core/signup_form_layout

    Signup form layout override for Modern Blue theme.
}}
<div class="signupform modern-blue-signup-form">
    <h1 class="login-heading">{{#str}}newaccount{{/str}}</h1>
    <div class="modern-blue-signup-formhtml">
        {{{formhtml}}}
    </div>
</div>
{{#js}}
require(['jquery'], function($) {
    var $page = $('#page-login-signup');
    if (!$page.length) {
        return;
    }

    var $form = $page.find('.modern-blue-signup-form .mform').first();
    if (!$form.length || $form.data('modernBlueAccordionReady')) {
        return;
    }
    $form.data('modernBlueAccordionReady', true);

    var utilitySelector = '#fitem_id_recaptcha_element, #fgroup_id_buttonar, .fitem_actionbuttons, .fdescription.required';
    var $rows = $form.children('.fitem, .form-group, .fdescription, fieldset.fitem');
    if (!$rows.length) {
        return;
    }

    var isUtilityRow = function($row) {
        return $row.is(utilitySelector);
    };

    var mapSectionKey = function($row) {
        var rowid = $row.attr('id') || '';
        var isFieldset = $row.is('fieldset');

        if (isFieldset && /id_category_/i.test(rowid)) {
            var legendtext = $.trim($row.find('legend').first().text()).toLowerCase();
            if (/academic|program|study|registration/.test(legendtext)) {
                return 'academic';
            }
            if (/personal|profile/.test(legendtext)) {
                return 'personal';
            }
            return 'academic';
        }

        if ($row.hasClass('fdescription') || /fitem_id_(username|password|passwordpolicyinfo)/.test(rowid)) {
            return 'account';
        }

        if (/fitem_id_(email2?|firstname|lastname|firstnamephonetic|lastnamephonetic|middlename|alternatename|city|country|auth_instructions|policyagreed)/.test(rowid)) {
            return 'personal';
        }

        return 'academic';
    };

    var sectionConfigs = [
        {key: 'account', step: '1', title: 'Account Details'},
        {key: 'personal', step: '2', title: 'Personal Information'},
        {key: 'academic', step: '3', title: 'Academic Details'}
    ];

    var $accordion = $('<div>', {
        'class': 'modern-blue-signup-accordion',
        'data-modern-blue-accordion': 'true'
    });

    var sections = {};

    sectionConfigs.forEach(function(config) {
        var panelid = 'modern-blue-signup-panel-' + config.key;
        var $section = $('<section>', {
            'class': 'modern-blue-signup-section',
            'data-section': config.key
        });
        var $toggle = $('<button>', {
            'class': 'modern-blue-signup-section-toggle',
            'type': 'button',
            'aria-expanded': 'false',
            'aria-controls': panelid
        });
        var $titleWrap = $('<span>', {'class': 'modern-blue-signup-title-wrap'});
        $titleWrap.append($('<span>', {'class': 'modern-blue-signup-step', text: config.step}));
        $titleWrap.append(document.createTextNode(' '));
        $titleWrap.append($('<span>', {'class': 'modern-blue-signup-section-title', text: config.title}));
        $toggle.append($titleWrap);
        $toggle.append($('<span>', {'class': 'modern-blue-signup-chevron', 'aria-hidden': 'true'}));

        var $panel = $('<div>', {
            'class': 'modern-blue-signup-section-panel',
            'id': panelid,
            'hidden': 'hidden'
        });

        $section.append($toggle, $panel);
        $accordion.append($section);
        sections[config.key] = {$section: $section, $toggle: $toggle, $panel: $panel};
    });

    var $firstRow = $rows.first();
    if ($firstRow.length) {
        $firstRow.before($accordion);
    } else {
        $form.prepend($accordion);
    }

    $rows.each(function() {
        var $row = $(this);
        if (isUtilityRow($row)) {
            return;
        }

        if ($row.is('fieldset.fitem')) {
            var fieldsetSectionKey = mapSectionKey($row);
            var $container = $row.children('.fcontainer').first();
            var $nestedRows = $container.children('.fitem, .form-group, .fdescription');

            if (!$nestedRows.length) {
                $nestedRows = $row.children('.fitem, .form-group, .fdescription');
            }

            if ($nestedRows.length) {
                $nestedRows.each(function() {
                    var $nested = $(this);
                    if (isUtilityRow($nested)) {
                        return;
                    }
                    $nested.addClass('modern-blue-signup-row');
                    sections[fieldsetSectionKey].$panel.append($nested);
                });
            }

            $row.remove();
            return;
        }

        var sectionKey = mapSectionKey($row);
        $row.addClass('modern-blue-signup-row');
        sections[sectionKey].$panel.append($row);
    });

    var markHalfRows = function(sectionKey, ids) {
        ids.forEach(function(id) {
            sections[sectionKey].$panel.children(id).addClass('modern-blue-row-half');
        });
    };

    markHalfRows('account', ['#fitem_id_username', '#fitem_id_password']);
    markHalfRows('personal', ['#fitem_id_email', '#fitem_id_email2', '#fitem_id_firstname', '#fitem_id_lastname']);
    markHalfRows('academic', ['#fitem_id_profile_field_program_study', '#fitem_id_profile_field_reg_number', '#fitem_id_profile_field_year_of_study']);

    if (!sections.academic.$panel.children().length) {
        sections.academic.$panel.append(
            $('<p>', {
                'class': 'modern-blue-signup-empty',
                'text': 'Additional academic fields will appear here when available.'
            })
        );
    }

    var addHint = function(rowSelector, text) {
        var $row = $form.find(rowSelector).first();
        var $feedback = $row.find('.form-control-feedback').first();
        if (!$row.length || !$feedback.length || $row.find('.modern-blue-field-hint').length) {
            return;
        }
        $('<p>', {
            'class': 'modern-blue-field-hint',
            'text': text
        }).insertBefore($feedback);
    };

    var setPlaceholder = function(inputSelector, text) {
        var $input = $form.find(inputSelector).first();
        if ($input.length && !$input.attr('placeholder')) {
            $input.attr('placeholder', text);
        }
    };

    addHint('#fitem_id_username', 'Lowercase letters only.');
    addHint('#fitem_id_password', 'Min 8 chars, 1 digit, 1 lowercase.');

    setPlaceholder('#id_username', 'Enter username');
    setPlaceholder('#id_password', 'Enter password');
    setPlaceholder('#id_email', 'name@example.com');
    setPlaceholder('#id_email2', 'name@example.com');
    setPlaceholder('#id_profile_field_reg_number', 'Enter registration number');

    var $passwordPolicy = $form.find('#fitem_id_passwordpolicyinfo .form-control-static').first();
    if ($passwordPolicy.length) {
        $passwordPolicy.text('Min 8 chars, include digit, uppercase, lowercase, and symbol.');
    }

    var $utilityRows = $form.children(utilitySelector);
    var $utility = $('<div>', {'class': 'modern-blue-signup-utility'});
    var $recaptchaRow = $utilityRows.filter('#fitem_id_recaptcha_element').first();
    var $actionRows = $utilityRows.filter('#fgroup_id_buttonar, .fitem_actionbuttons');

    if ($recaptchaRow.length) {
        $utility.append($recaptchaRow);
    } else {
        var $mockRecaptcha = $('<div>', {
            'class': 'modern-blue-signup-recaptcha',
            'aria-hidden': 'true'
        });
        $mockRecaptcha.append($('<span>', {'class': 'modern-blue-signup-recaptcha-check'}));
        $mockRecaptcha.append($('<span>', {'class': 'modern-blue-signup-recaptcha-text', 'text': "I'm not a robot"}));
        $mockRecaptcha.append($('<span>', {'class': 'modern-blue-signup-recaptcha-badge', 'text': 'reCAPTCHA'}));
        $utility.append($mockRecaptcha);
    }

    if ($actionRows.length) {
        $actionRows.addClass('modern-blue-signup-actions-row');
        var $submit = $actionRows.find('input#id_submitbutton, input[name="submitbutton"]').first();
        if ($submit.length) {
            $submit.val('Create Account ->');
        }

        var $cancelBlock = $actionRows.find('.btn-cancel').first();
        if ($cancelBlock.length) {
            $cancelBlock.hide();
        } else {
            $actionRows.find('input#id_cancel').closest('.fitem').hide();
        }

        $utility.append($actionRows);
    }

    if ($utility.children().length) {
        $form.append($utility);
    }

    var $requiredInfo = $form.children('.fdescription.required');
    if ($requiredInfo.length) {
        $requiredInfo.hide();
    }

    if (!$form.find('.modern-blue-login-prompt').length) {
        var loginUrl = ((window.M && window.M.cfg && window.M.cfg.wwwroot) ? window.M.cfg.wwwroot : '') + '/login/index.php';
        var $loginPrompt = $('<p>', {'class': 'modern-blue-login-prompt'});
        $loginPrompt.append(document.createTextNode('Already have an account? '));
        $loginPrompt.append($('<a>', {'href': loginUrl, 'text': 'Log in here.'}));
        $utility.append($loginPrompt);
    }

    var setOpenSection = function(sectionKey) {
        Object.keys(sections).forEach(function(key) {
            var section = sections[key];
            var isOpen = key === sectionKey;
            section.$section.toggleClass('is-open', isOpen);
            section.$toggle.attr('aria-expanded', isOpen ? 'true' : 'false');
            if (isOpen) {
                section.$panel.removeAttr('hidden');
            } else {
                section.$panel.attr('hidden', 'hidden');
            }
        });
    };

    var panelHasErrors = function($panel) {
        if ($panel.find('.is-invalid, .has-danger').length) {
            return true;
        }
        return $panel.find('.invalid-feedback, .form-control-feedback').filter(function() {
            return $.trim($(this).text()).length > 0;
        }).length > 0;
    };

    var defaultOpen = 'account';
    sectionConfigs.some(function(config) {
        if (panelHasErrors(sections[config.key].$panel)) {
            defaultOpen = config.key;
            return true;
        }
        return false;
    });
    setOpenSection(defaultOpen);

    sectionConfigs.forEach(function(config) {
        sections[config.key].$toggle.on('click', function() {
            if (!sections[config.key].$section.hasClass('is-open')) {
                setOpenSection(config.key);
            }
        });
    });
});
{{/js}}
